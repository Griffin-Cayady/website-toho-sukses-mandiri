# Supabase Configuration
# Obtain these from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public storage bucket that holds the product photos (product_image_1..5 are file names in it)
NEXT_PUBLIC_SUPABASE_IMAGE_BUCKET=your-bucket-name

# CORS: in Supabase Dashboard -> Authentication -> URL Configuration, add your local
# URL (http://localhost:3000) and production domain(s), or requests will be rejected.
