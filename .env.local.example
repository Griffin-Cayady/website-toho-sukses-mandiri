# Copy to .env.local. The MySQL login is not here: it goes in toho-db-config.php (see toho-db-config.example.php).

# PHP API. Leave unset in production (the site calls /api on its own domain).
# Local `npm run dev`: run `npm run api` alongside and use:
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Folder that holds the product/category photos; database values are file paths inside it.
NEXT_PUBLIC_IMAGE_BASE_URL=https://your-domain.com/TSM_DB_Dev
